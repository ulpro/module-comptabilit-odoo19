<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_customer_statement" model="ir.actions.report">
        <field name="name">Customer Statement</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">om_account_followup.report_customer_statement</field>
        <field name="print_report_name">'Statement - %s' % (object.name or '')</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_type">report</field>
        <field name="group_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>

    <record id="action_report_vendor_statement" model="ir.actions.report">
        <field name="name">Vendor Statement</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">om_account_followup.report_vendor_statement</field>
        <field name="print_report_name">'Vendor Statement - %s' % (object.name or '')</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_type">report</field>
        <field name="group_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>

    <template id="report_customer_statement_document">
        <t t-set="is_vendor" t-value="statement_type == 'vendor'"/>
        <t t-call="web.external_layout">
            <t t-set="address">
                <address t-field="partner.self"
                         t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                <div t-if="partner.vat">
                    <t t-out="company.account_fiscal_country_id.vat_label or 'Tax ID'"/>: <span t-field="partner.vat"/>
                </div>
            </t>
            <div class="page o_om_report">
                <t t-call="om_account_followup.report_style"/>
                <h2 t-if="is_vendor">Relevé de compte fournisseur</h2>
                <h2 t-else="">Relevé de compte client</h2>
                <div id="informations" class="row mb-4">
                    <div class="col">
                        <strong>Date</strong>
                        <div t-out="today_label"/>
                    </div>
                    <div class="col" t-if="partner.ref">
                        <strong t-if="is_vendor">Référence fournisseur</strong>
                        <strong t-else="">Référence client</strong>
                        <div t-field="partner.ref"/>
                    </div>
                    <div class="col" t-if="not is_vendor and partner.latest_followup_level_id">
                        <strong>Niveau de relance</strong>
                        <div t-field="partner.latest_followup_level_id.name"/>
                    </div>
                </div>

                <p t-if="not is_vendor and level_text(partner)" style="white-space: pre-line;" t-out="level_text(partner)"/>

                <t t-foreach="statement(partner)" t-as="group">
                    <t t-set="currency" t-value="group['currency']"/>
                    <table class="table table-sm o_main_table mt-4">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Document</th>
                                <th>Référence</th>
                                <th>Date d'échéance</th>
                                <th class="text-end">Jours de retard</th>
                                <th class="text-end">Montant</th>
                                <th class="text-end">Solde restant dû</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="group['lines']" t-as="item"
                                t-att-class="'text-muted' if item['disputed'] else ('fw-bold' if item['overdue'] and item['residual'] &gt; 0 else '')">
                                <td class="o_om_date"><span t-out="format_date(item['date'])"/></td>
                                <td>
                                    <span t-out="item['name']"/>
                                    <span t-if="item['disputed']" class="badge text-bg-secondary ms-1">En litige</span>
                                </td>
                                <td><span t-out="item['ref']"/></td>
                                <td class="o_om_date"><span t-out="format_date(item['date_maturity'])"/></td>
                                <td class="text-end"><span t-if="item['days_overdue']" t-out="item['days_overdue']"/></td>
                                <td class="text-end">
                                    <span t-out="item['amount']"
                                          t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                                <td class="text-end">
                                    <span t-out="item['residual']"
                                          t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                            </tr>
                        </tbody>
                        <tbody>
                            <tr class="o_om_total">
                                <td colspan="6">Total restant dû</td>
                                <td class="text-end">
                                    <span t-out="group['total']"
                                          t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                            </tr>
                            <tr class="o_om_total">
                                <td colspan="6">Montant échu (en retard)</td>
                                <td class="text-end">
                                    <span t-out="group['total_overdue']"
                                          t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <h4>Balance âgée</h4>
                    <table class="table table-sm text-center">
                        <thead>
                            <tr>
                                <th t-foreach="group['ageing']" t-as="bucket" t-out="bucket[0]"/>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td t-foreach="group['ageing']" t-as="bucket">
                                    <span t-out="bucket[1]"
                                          t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </t>
                <p t-if="not statement(partner)">Aucun solde ouvert sur ce compte.</p>

                <div t-if="bank_accounts and not is_vendor" class="mt-4">
                    <strong>Coordonnées de règlement</strong>
                    <p class="m-0" t-foreach="bank_accounts" t-as="bank">
                        <span t-out="bank.display_name"/>
                    </p>
                </div>
                <p t-if="is_vendor" class="mt-3 text-muted">
                    Merci de bien vouloir rapprocher ces montants ouverts avec vos enregistrements et signaler toute anomalie à notre service comptable.
                </p>
                <p t-else="" class="mt-3 text-muted">
                    Si votre règlement a déjà été effectué, nous vous prions de ne pas tenir compte des montants échus. Pour toute question relative à ce relevé, merci de contacter notre service comptable.
                </p>
            </div>
        </t>
    </template>

    <template id="report_customer_statement">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="partner">
                <t t-set="partner" t-value="partner.with_context(lang=partner.lang)"/>
                <t t-call="om_account_followup.report_customer_statement_document" t-lang="partner.lang"/>
            </t>
        </t>
    </template>

    <template id="report_vendor_statement">
        <t t-call="om_account_followup.report_customer_statement"/>
    </template>

</odoo>
