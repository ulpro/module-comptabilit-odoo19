<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="asset_sell_form" model="ir.ui.view">
        <field name="name">asset.sell.form</field>
        <field name="model">asset.sell</field>
        <field name="arch" type="xml">
            <form string="Cession ou Mise au rebut">
                <field name="asset_id" invisible="1"/>
                <field name="asset_state" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <group>
                    <group>
                        <field name="action" widget="radio" options="{'horizontal': true}"/>
                        <field name="date"/>
                        <field name="book_value"/>
                    </group>
                    <group>
                        <field name="account_asset_gain_id" string="Compte de plus-value" required="action == 'sell'"/>
                        <field name="account_asset_loss_id" string="Compte de moins-value" required="1"/>
                    </group>
                </group>
                <group invisible="action != 'sell'">
                    <field name="sale_invoice_ids" widget="many2many_tags"
                           options="{'no_create': True}" required="action == 'sell'"/>
                    <field name="sale_amount"/>
                </group>
                <group>
                    <field name="note" placeholder="Motif de la cession ou de la mise au rebut..."/>
                </group>
                <p class="text-muted">
                    L'actif est amorti jusqu'à cette date, puis une écriture supprime sa valeur brute
                    ainsi que les amortissements cumulés et comptabilise la différence avec le prix de vente
                    en plus-value ou moins-value de cession.
                </p>
                <footer>
                    <button name="action_confirm" string="Confirmer" type="object" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_asset_sell" model="ir.actions.act_window">
        <field name="name">Sell or Dispose</field>
        <field name="res_model">asset.sell</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="asset_sell_form"/>
        <field name="target">new</field>
    </record>

</odoo>
