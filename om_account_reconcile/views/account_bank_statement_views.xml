<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The account module has no list nor form for the transactions and the statements: the generated ones cannot
         be used to type a transaction in, e.g. the petty cash spent during the day. -->

    <record id="view_bank_statement_line_list" model="ir.ui.view">
        <field name="name">account.bank.statement.line.list.om.account.reconcile</field>
        <field name="model">account.bank.statement.line</field>
        <field name="arch" type="xml">
            <list string="Transactions" decoration-muted="is_reconciled" default_order="date desc, id desc">
                <field name="date"/>
                <field name="payment_ref" string="Libellé"/>
                <field name="partner_id" string="Partenaire"/>
                <field name="statement_id" string="Relevé" optional="show"/>
                <field name="journal_id" string="Journal" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount" sum="Total" string="Montant"/>
                <field name="running_balance" optional="hide"/>
                <field name="checked" string="Révisé" widget="boolean" optional="show" readonly="1"/>
                <field name="is_reconciled" string="Rapproché" widget="boolean" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_bank_statement_line_search" model="ir.ui.view">
        <field name="name">account.bank.statement.line.search.om.account.reconcile</field>
        <field name="model">account.bank.statement.line</field>
        <field name="arch" type="xml">
            <search string="Transactions">
                <field name="payment_ref" string="Libellé"/>
                <field name="partner_id" string="Partenaire"/>
                <field name="amount" string="Montant"/>
                <field name="journal_id" string="Journal"/>
                <field name="statement_id" string="Relevé"/>
                <filter name="to_reconcile" string="À rapprocher" domain="[('is_reconciled', '=', False)]"/>
                <filter name="reconciled" string="Rapproché" domain="[('is_reconciled', '=', True)]"/>
                <separator/>
                <filter name="to_review" string="À vérifier"
                        domain="[('move_id.state', '=', 'posted'), ('move_id.checked', '=', False)]"/>
                <separator/>
                <filter name="date" string="Date" date="date"/>
                <group>
                    <filter name="group_by_journal" string="Journal" context="{'group_by': 'journal_id'}"/>
                    <filter name="group_by_statement" string="Relevé" context="{'group_by': 'statement_id'}"/>
                    <filter name="group_by_date" string="Date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_bank_statement_line_form" model="ir.ui.view">
        <field name="name">account.bank.statement.line.form.om.account.reconcile</field>
        <field name="model">account.bank.statement.line</field>
        <field name="arch" type="xml">
            <form string="Transaction">
                <header>
                    <button name="om_action_reconcile" type="object" string="Rapprocher" class="btn-primary"
                            invisible="not id or is_reconciled" groups="account.group_account_basic"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Rapproché" invisible="not is_reconciled"/>
                    <field name="is_reconciled" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <group>
                        <group>
                            <field name="journal_id" readonly="id" options="{'no_create': True}"
                                    domain="[('type', 'in', ('bank', 'cash', 'credit'))]"/>
                            <field name="date" readonly="is_reconciled"/>
                            <field name="payment_ref" string="Libellé" required="1" placeholder="Ex. Fournitures de bureau"/>
                            <field name="partner_id" readonly="is_reconciled"/>
                        </group>
                        <group>
                            <field name="amount" readonly="is_reconciled"
                                   help="Positif pour l'argent reçu, négatif pour l'argent dépensé."/>
                            <field name="foreign_currency_id" groups="base.group_multi_currency"
                                   readonly="is_reconciled" options="{'no_create': True}"/>
                            <field name="amount_currency" groups="base.group_multi_currency"
                                   invisible="not foreign_currency_id" readonly="is_reconciled"/>
                            <field name="statement_id" domain="[('journal_id', '=', journal_id)]"
                                   options="{'no_create': True}"/>
                            <field name="ref" string="Référence"/>
                        </group>
                    </group>
                    <field name="narration" placeholder="Notes..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bank_statement_line" model="ir.actions.act_window">
        <field name="name">Transactions</field>
        <field name="res_model">account.bank.statement.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_bank_statement_line_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Ajouter une transaction</p>
            <p>L'argent reçu et dépensé sur le compte, tel qu'indiqué sur le relevé de banque ou le comptage de caisse.</p>
        </field>
    </record>

    <record id="view_bank_statement_form" model="ir.ui.view">
        <field name="name">account.bank.statement.form.om.account.reconcile</field>
        <field name="model">account.bank.statement</field>
        <field name="arch" type="xml">
            <form string="Relevé bancaire">
                <sheet>
                    <field name="currency_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="is_valid" invisible="1"/>
                    <div class="alert alert-warning" role="alert" invisible="is_complete or not line_ids">
                        Le solde final ne correspond pas au solde initial additionné des transactions : vérifiez les montants, ou une transaction est manquante.
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="is_valid or not id">
                        Le solde initial diffère du solde final du relevé précédent.
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Relevé"/>
                        <h1><field name="name" placeholder="Ex. Caisse du 16 septembre"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="journal_id" readonly="1" force_save="1"/>
                            <field name="date"/>
                            <field name="reference" string="Référence externe"/>
                        </group>
                        <group>
                            <field name="balance_start" string="Solde initial"/>
                            <field name="balance_end" string="Solde calculé"/>
                            <field name="balance_end_real" string="Solde final"/>
                            <field name="is_complete" invisible="1"/>
                        </group>
                    </group>
                    <!-- the date of a statement of 19.0 is the one of its lines: the date of the day until then -->
                    <field name="line_ids" context="{'default_journal_id': journal_id or context.get('default_journal_id'), 'default_date': date or context.get('default_date')}">
                        <list editable="bottom" decoration-muted="is_reconciled">
                            <field name="journal_id" column_invisible="True"/>
                            <field name="date"/>
                            <field name="payment_ref" string="Libellé" required="1"/>
                            <field name="partner_id" string="Partenaire" readonly="is_reconciled"/>
                            <field name="ref" string="Référence" optional="hide"/>
                            <field name="currency_id" column_invisible="True"/>
                            <field name="amount" sum="Total" string="Montant" readonly="is_reconciled"/>
                            <field name="is_reconciled" string="Rapproché" widget="boolean" optional="show"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
