<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_trialbalance">
        <t t-call="web.html_container"
            data_report_dpi="110">
            <t t-call="web.internal_layout">
                <div class="page o_om_report">
                        <t t-call="accounting_pdf_reports.report_style"/>
                    <h2>Balance Générale</h2>

                    <div id="informations" class="row mb-4">
                        <div class="col" t-if="data['date_from'] or data['date_to']">
                            <strong>Période :</strong>
                            <div>
                                <t t-if="data['date_from'] and data['date_to']"><span t-out="data['date_from']" t-options="{'widget': 'date'}"/> - <span t-out="data['date_to']" t-options="{'widget': 'date'}"/></t>
                                <t t-elif="data['date_from']">Du <span t-out="data['date_from']" t-options="{'widget': 'date'}"/></t>
                                <t t-else="">Jusqu'au <span t-out="data['date_to']" t-options="{'widget': 'date'}"/></t>
                            </div>
                        </div>
                        <div class="col">
                            <strong>Mouvements cibles :</strong>
                            <div t-if="data['target_move'] == 'all'">Toutes les écritures</div>
                            <div t-if="data['target_move'] == 'posted'">Toutes les écritures comptabilisées</div>
                        </div>
                        <div class="col">
                            <strong>Afficher les comptes :</strong>
                            <div t-if="data['display_account'] == 'all'">Tous les comptes</div>
                            <div t-if="data['display_account'] == 'movement'">Avec des mouvements</div>
                            <div t-if="data['display_account'] == 'not_zero'">Avec un solde non nul</div>
                        </div>
                    </div>
                    <div class="o_om_info row mb-4">
                        <div class="col">
                            <strong>Journaux :</strong>
                            <div t-out="', '.join([journal or '' for journal in print_journal])"/>
                        </div>
                        <div class="col" t-if="analytic_accounts"
                             groups="analytic.group_analytic_accounting">
                            <strong>Comptes analytiques :</strong>
                            <div t-out="', '.join([analytic_account or '' for analytic_account in analytic_accounts])"/>
                        </div>
                    </div>

                    <table class="table table-sm table-reports">
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Compte</th>
                                <th class="text-end">Débit</th>
                                <th class="text-end">Crédit</th>
                                <th class="text-end">Solde</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="Accounts" t-as="account">
                                <td>
                                    <span t-att-style="style" t-out="account['code']"/>
                                </td>
                                <td>
                                    <span t-att-style="style" t-out="account['name']"/>
                                </td>
                                <td class="text-end text-nowrap">
                                    <span t-att-style="style" t-out="account['debit']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                </td>
                                <td class="text-end text-nowrap">
                                    <span t-att-style="style" t-out="account['credit']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                </td>
                                <td class="text-end text-nowrap">
                                    <span t-att-style="style" t-out="account['balance']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                </td>
                            </tr>
                            <!-- A trial balance exists to show the two columns agree,
                                 so it has to add them up. -->
                            <tr t-if="Accounts" class="o_om_total">
                                <td/>
                                <td><strong>Total</strong></td>
                                <td class="text-end text-nowrap">
                                    <strong t-out="sum(account['debit'] for account in Accounts)"
                                            t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                </td>
                                <td class="text-end text-nowrap">
                                    <strong t-out="sum(account['credit'] for account in Accounts)"
                                            t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                </td>
                                <td class="text-end text-nowrap">
                                    <strong t-out="sum(account['balance'] for account in Accounts)"
                                            t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

</odoo>
