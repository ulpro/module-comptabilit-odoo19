<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_general_ledger">
        <t t-call="web.html_container"
            data_report_dpi="110">
            <t t-call="web.internal_layout">
                <div class="page o_om_report">
                        <t t-call="accounting_pdf_reports.report_style"/>
                    <h2>Grand Livre Général</h2>

                    <div id="informations" class="row mb-4">
                        <div class="col" t-if="data['date_from'] or data['date_to']">
                            <strong>Période :</strong>
                            <div>
                                <t t-if="data['date_from'] and data['date_to']"><span t-out="data['date_from']" t-options="{'widget': 'date'}"/> - <span t-out="data['date_to']" t-options="{'widget': 'date'}"/></t>
                                <t t-elif="data['date_from']">Du <span t-out="data['date_from']" t-options="{'widget': 'date'}"/></t>
                                <t t-else="">Jusqu'au <span t-out="data['date_to']" t-options="{'widget': 'date'}"/></t>
                            </div>
                        </div>
                        <div class="col">
                            <strong>Mouvements cibles :</strong>
                            <div t-if="data['target_move'] == 'all'">Toutes les écritures</div>
                            <div t-if="data['target_move'] == 'posted'">Toutes les écritures comptabilisées</div>
                        </div>
                        <div class="col">
                            <strong>Trier par :</strong>
                            <div t-if="data['sortby'] == 'sort_date'">Date</div>
                            <div t-if="data['sortby'] == 'sort_journal_partner'">Journal et Partenaire</div>
                        </div>
                        <div class="col">
                            <strong>Afficher les comptes :</strong>
                            <div t-if="data['display_account'] == 'all'">Tous les comptes</div>
                            <div t-if="data['display_account'] == 'movement'">Avec des mouvements</div>
                            <div t-if="data['display_account'] == 'not_zero'">Avec un solde non nul</div>
                        </div>
                    </div>
                    <div class="o_om_info row mb-4">
                        <div class="col">
                            <strong>Journaux :</strong>
                            <div t-out="', '.join([journal or '' for journal in print_journal])"/>
                        </div>
                        <t groups="analytic.group_analytic_accounting">
                            <div class="col" t-if="analytic_account_ids">
                                <strong>Comptes analytiques :</strong>
                                <div t-out="', '.join([aa.name or '' for aa in analytic_account_ids])"/>
                            </div>
                        </t>
                    </div>

                    <table class="table table-sm table-reports">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>JRNL</th>
                                <th>Partenaire</th>
                                <th>Réf</th>
                                <th>Pièce</th>
                                <t groups="analytic.group_analytic_accounting">
                                    <th>Compte analytique</th>
                                </t>
                                <th>Libellé écriture</th>
                                <th class="text-end">Débit</th>
                                <th class="text-end">Crédit</th>
                                <th class="text-end">Solde</th>
                                <th class="text-end" groups="base.group_multi_currency">Currency</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="Accounts" t-as="account">
                                <tr style="font-weight: bold;">
                                    <td colspan="6">
                                        <span t-out="account['code']"/>
                                        <span t-out="account['name']"/>
                                    </td>
                                    <t groups="analytic.group_analytic_accounting">
                                        <td></td>
                                    </t>
                                    <td class="text-end text-nowrap">
                                        <span t-out="account['debit']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <span t-out="account['credit']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <span t-out="account['balance']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                    <td groups="base.group_multi_currency"/>
                                </tr>
                                <tr t-foreach="account['move_lines']" t-as="line">
                                    <td class="o_om_date"><span t-out="line['ldate']"/></td>
                                    <td><span t-out="line['lcode']"/></td>
                                    <td><span t-out="line['partner_name']"/></td>
                                    <td><span t-if="line['lref']" t-out="line['lref']"/></td>
                                    <td><span t-out="line['move_name']"/></td>
                                    <t groups="analytic.group_analytic_accounting">
                                        <td><span t-out="line['analytic_account_id']"/></td>
                                    </t>
                                    <td><span t-out="line['lname']"/></td>
                                    <td class="text-end text-nowrap">
                                        <span t-out="line['debit']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <span t-out="line['credit']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <span t-out="line['balance']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                    <td class="text-end" groups="base.group_multi_currency">
                                        <span t-if="line['amount_currency']" t-out="line['amount_currency']" t-options="{'widget': 'float', 'precision': 2}"/>
                                        <span t-out="line['currency_code'] if line['amount_currency'] else ''"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

</odoo>
