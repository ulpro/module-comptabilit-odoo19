<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_journal">
        <t t-call="web.html_container"
            data_report_dpi="110">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.internal_layout">
                    <div class="page o_om_report">
                        <t t-call="accounting_pdf_reports.report_style"/>
                        <h2>Journal Centralisateur : <t t-out="o.name"/></h2>

                        <div id="informations" class="row mb-4">
                            <div class="col">
                                <strong>Journal :</strong>
                                <div t-out="o.name"/>
                            </div>
                            <div class="col">
                                <strong>Trier par :</strong>
                                <div t-if="data['form'].get('sort_selection') != 'date'">Numéro d'écriture</div>
                                <div t-if="data['form'].get('sort_selection') == 'date'">Date</div>
                            </div>
                            <div class="col">
                                <strong>Mouvements cibles :</strong>
                                <div t-if="data['form']['target_move'] == 'all'">Toutes les écritures</div>
                                <div t-if="data['form']['target_move'] == 'posted'">Toutes les écritures comptabilisées</div>
                            </div>
                        </div>

                        <table class="table table-sm table-reports">
                            <thead>
                                <tr>
                                    <th>Pièce</th>
                                    <th>Date</th>
                                    <th>Compte</th>
                                    <th>Partenaire</th>
                                    <th>Libellé</th>
                                    <th class="text-end">Débit</th>
                                    <th class="text-end">Crédit</th>
                                    <th class="text-end" t-if="data['form']['amount_currency']">Devise</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="lines[o.id]" t-as="aml">
                                    <td><span t-out="aml.move_id.name != '/' and aml.move_id.name or ('*'+str(aml.move_id.id))"/></td>
                                    <td><span t-field="aml.date"/></td>
                                    <td><span t-field="aml.account_id.code"/></td>
                                    <td><span t-out="aml.sudo().partner_id.name or ''"/></td>
                                    <td><span t-out="aml.name or ''"/></td>
                                    <td class="text-end text-nowrap"><span t-out="aml.debit" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/></td>
                                    <td class="text-end text-nowrap"><span t-out="aml.credit" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/></td>
                                    <td class="text-end" t-if="data['form']['amount_currency']">
                                        <span t-if="aml.amount_currency" t-out="aml.amount_currency" t-options="{'widget': 'monetary', 'display_currency': aml.currency_id}"/>
                                    </td>
                                </tr>
                            </tbody>

                            <tfoot>
                                <tr class="o_journal_audit_total o_om_total">
                                    <td colspan="5"><strong>Total</strong></td>
                                    <td class="text-end text-nowrap">
                                        <strong><span t-out="sum_debit(data, o)" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/></strong>
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <strong><span t-out="sum_credit(data, o)" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/></strong>
                                    </td>
                                    <td t-if="data['form']['amount_currency']"/>
                                </tr>
                            </tfoot>
                        </table>
                        <t t-set="taxes" t-value="get_taxes(data, o)"/>
                        <div t-if="taxes" class="row mt-4">
                            <div class="col-6">
                                <table class="table table-sm table-reports">
                                    <thead>
                                        <tr><th colspan="3">Déclaration de taxes</th></tr>
                                        <tr>
                                            <th>Nom</th>
                                            <th class="text-end">Montant de base</th>
                                            <th class="text-end">Montant taxe</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="taxes" t-as="tax">
                                            <td><span t-out="tax.name"/></td>
                                            <td class="text-end text-nowrap"><span t-out="taxes[tax]['base_amount']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/></td>
                                            <td class="text-end text-nowrap"><span t-out="taxes[tax]['tax_amount']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
