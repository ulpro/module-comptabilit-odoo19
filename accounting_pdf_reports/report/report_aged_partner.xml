<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_agedpartnerbalance">
        <t t-call="web.html_container"
            data_report_dpi="110">
            <t t-call="web.internal_layout">
                <div class="page o_om_report">
                        <t t-call="accounting_pdf_reports.report_style"/>
                    <h2>Balance Âgée Tiers</h2>

                    <div id="informations" class="row mb-4">
                        <div class="col">
                            <strong>À la date du :</strong>
                            <div t-out="data['date_from']" t-options="{'widget': 'date'}"/>
                        </div>
                        <div class="col">
                            <strong>Durée de période (jours) :</strong>
                            <div t-out="data['period_length']"/>
                        </div>
                        <div class="col">
                            <strong>Tiers :</strong>
                            <div t-if="data['result_selection'] == 'customer'">Comptes clients</div>
                            <div t-if="data['result_selection'] == 'supplier'">Comptes fournisseurs</div>
                            <div t-if="data['result_selection'] == 'customer_supplier'">Comptes clients et fournisseurs</div>
                        </div>
                        <div class="col">
                            <strong>Mouvements cibles :</strong>
                            <div t-if="data['target_move'] == 'all'">Toutes les écritures</div>
                            <div t-if="data['target_move'] == 'posted'">Toutes les écritures comptabilisées</div>
                        </div>
                    </div>

                    <table class="table table-sm table-reports">
                        <thead>
                            <tr>
                                <th>Partenaires</th>
                                <th class="text-end">Non échu</th>
                                <th class="text-end"><span t-out="data['4']['name']"/></th>
                                <th class="text-end"><span t-out="data['3']['name']"/></th>
                                <th class="text-end"><span t-out="data['2']['name']"/></th>
                                <th class="text-end"><span t-out="data['1']['name']"/></th>
                                <th class="text-end"><span t-out="data['0']['name']"/></th>
                                <th class="text-end">Total</th>
                            </tr>
                            <tr t-if="get_partner_lines" class="o_om_total">
                                <th>Total Général</th>
                                <th class="text-end text-nowrap"><span t-out="get_direction[6]" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/></th>
                                <th class="text-end text-nowrap"><span t-out="get_direction[4]" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/></th>
                                <th class="text-end text-nowrap"><span t-out="get_direction[3]" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/></th>
                                <th class="text-end text-nowrap"><span t-out="get_direction[2]" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/></th>
                                <th class="text-end text-nowrap"><span t-out="get_direction[1]" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/></th>
                                <th class="text-end text-nowrap"><span t-out="get_direction[0]" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/></th>
                                <th class="text-end text-nowrap"><span t-out="get_direction[5]" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="get_partner_lines" t-as="partner">
                                <td>
                                    <span t-out="partner['name']"/>
                                </td>
                                <td class="text-end text-nowrap">
                                    <span t-out="partner['direction']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                </td>
                                <td class="text-end text-nowrap">
                                    <span t-out="partner['4']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                </td>
                                <td class="text-end text-nowrap">
                                    <span t-out="partner['3']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                </td>
                                <td class="text-end text-nowrap">
                                    <span t-out="partner['2']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                </td>
                                <td class="text-end text-nowrap">
                                    <span t-out="partner['1']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                </td>
                                <td class="text-end text-nowrap">
                                    <span t-out="partner['0']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                </td>
                                <td class="text-end text-nowrap">
                                    <span t-out="partner['total']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

</odoo>
